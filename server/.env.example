PORT=3010
CLIENT_ORIGIN=http://localhost:5173

# Local dev: matches docker-compose.yml at the repo root (docker compose up).
# Production: point these at your external Neon/Supabase + Upstash instances
# instead (see DEPLOY.md) — Render's own free Postgres/Redis aren't used.
DATABASE_URL=postgres://smg:smg@localhost:5433/sheet_music
REDIS_URL=redis://localhost:6380

# Set to "true" only for combined single-process deployment (Render). Leave
# unset for local dev — run `npm run worker` as a second process instead.
RUN_WORKER_INLINE=false

# Local dev only, and only if yt-dlp hits YouTube's bot check ("Sign in to
# confirm you're not a bot"): the browser to read cookies from. Never set
# this in production — there's no browser/user session on Render to read
# from.
#
# Chrome/Edge/other Chromium browsers (v127+, mid-2024 onward) do NOT
# reliably work here: cookies are encrypted with a key bound to the
# running browser process ("app-bound encryption"), so even with the
# browser fully closed (all processes, not just windows -- Chromium
# browsers keep running in the background for fast startup unless that's
# disabled in settings) yt-dlp can copy the cookie file but can't decrypt
# it. Confirmed hitting this wall in practice, not just per yt-dlp's docs.
# Firefox doesn't use this scheme and works while simply running. If only
# a Chromium browser is available, export a Netscape-format cookies.txt
# from it (e.g. via a "Get cookies.txt" extension) and use yt-dlp's
# --cookies <path> instead -- not currently wired up in transcribe.py.
# YT_DLP_COOKIES_BROWSER=firefox
